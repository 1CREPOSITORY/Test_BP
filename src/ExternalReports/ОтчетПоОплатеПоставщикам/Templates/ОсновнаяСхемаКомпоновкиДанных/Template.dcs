	<calculatedField>
		<dataPath>НомерДокументаОснованияPDA</dataPath>
		<expression>ВЫБОР
    КОГДА [ВидОплаты] = "PDA"
        ТОГДА [НомерДокумента]
    ИНАЧЕ ""
КОНЕЦ</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
