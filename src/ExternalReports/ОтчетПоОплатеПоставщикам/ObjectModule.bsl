////////////////////////////////////////////////////////////////////////////////
// Модуль формирования внешнего набора данных СКД.
//
// Результат: одна ТЗ ДанныеОтчета, уже сгруппированная по статьям затрат.
// Номенклатура используется только при вычислении и в итоговый набор не попадает.
//
// ВАЖНО:
// 1. Вставьте в ПолучитьТекстЗапросаДанныхОтчета() ваш текущий пакет запросов.
// 2. Функция СформироватьДанныеОтчета() принимает уже заполненные даты.
// 3. Строки с ВидОплаты = "Other" намеренно не включены: у них нет
//    номенклатуры и, следовательно, статьи затрат.
&НаСервере
Процедура ДобавитьКолонкиТаблицы(Таблица, СписокИменКолонок)

    Для Каждого ИмяКолонки Из СтрРазделить(СписокИменКолонок, ",") Цикл
        Таблица.Колонки.Добавить(СокрЛП(ИмяКолонки));
    КонецЦикла;

КонецПроцедуры


#Область КурсыВалют
	
&НаСервере
Функция ПересчитатьСуммуВUSD(Сумма, Валюта, ДатаПересчета, ВалютаUSD)

    Если Не ЗначениеЗаполнено(Сумма)
        ИЛИ Не ЗначениеЗаполнено(Валюта)
        ИЛИ Не ЗначениеЗаполнено(ДатаПересчета) Тогда
        Возврат 0;
    КонецЕсли;

    Возврат РаботаСКурсамиВалют.ПересчитатьВВалюту(
        Сумма,
        Валюта,
        ВалютаUSD,
        ДатаПересчета
    );

КонецФункции

// Загружает все курсы валют, нужные для пересчёта сумм в USD, одним запросом.
// Возвращает Соответствие: ключ = XMLСтрока(Валюта) + "_" + XMLСтрока(ДатаСписания),
//                          значение = Структура("Курс, Кратность").
// Используется для ускорения: один запрос вместо N вызовов СрезПоследних.
//
// Параметры:
//   ИсходныеДанные - ТаблицаЗначений - строки исходных данных отчёта.
//   ВалютаUSD      - СправочникСсылка.Валюты - валюта пересчёта; строки с этой валютой пропускаются.
//
// Возвращаемое значение:
//   Соответствие - кэш курсов для быстрого пересчёта.
&НаСервере
Функция ПолучитьКэшКурсовВалют(ИсходныеДанные, ВалютаUSD)

    КэшКурсов = Новый Соответствие;

    УникальныеПары = СобратьУникальныеПарыВалютИДат(ИсходныеДанные, ВалютаUSD);
    Если УникальныеПары.Количество() = 0 Тогда
        Возврат КэшКурсов;
    КонецЕсли;

    МассивВалют = Новый Массив;
    Для Каждого КиП Из УникальныеПары Цикл
        МассивВалют.Добавить(КиП.Ключ);
    КонецЦикла;

    КурсыПоВалютам = ЗагрузитьКурсыПоВалютам(МассивВалют);

    ЗаполнитьКэшИзКурсов(КэшКурсов, УникальныеПары, КурсыПоВалютам);

    Возврат КэшКурсов;

КонецФункции

// Собирает уникальные пары (Валюта -> Соответствие уникальных дат) из исходных данных.
// Пропускает строки с валютой USD (пересчёт не нужен) и строки с незаполненными полями.
//
// Параметры:
//   ИсходныеДанные - ТаблицаЗначений.
//   ВалютаUSD      - СправочникСсылка.Валюты.
//
// Возвращаемое значение:
//   Соответствие - ключ = Валюта, значение = Соответствие(Дата -> Истина).
&НаСервере
Функция СобратьУникальныеПарыВалютИДат(ИсходныеДанные, ВалютаUSD)

    УникальныеПары = Новый Соответствие;
    Для Каждого ИсходнаяСтрока Из ИсходныеДанные Цикл
        Если Не ТребуетсяПересчетВUSD(ИсходнаяСтрока, ВалютаUSD) Тогда
            Продолжить;
        КонецЕсли;
        Дата = НачалоДня(ИсходнаяСтрока.ДатаСписания);
        ДатыВалюты = УникальныеПары.Получить(ИсходнаяСтрока.ВалютаДокументаПоставщика);
        Если ДатыВалюты = Неопределено Тогда
            ДатыВалюты = Новый Соответствие;
            УникальныеПары.Вставить(ИсходнаяСтрока.ВалютаДокументаПоставщика, ДатыВалюты);
        КонецЕсли;
        ДатыВалюты.Вставить(Дата, Истина);
    КонецЦикла;

    Возврат УникальныеПары;

КонецФункции

// Возвращает Истина, если для строки исходных данных нужно пересчитывать сумму в USD.
//
// Параметры:
//   ИсходнаяСтрока - СтрокаТаблицыЗначений.
//   ВалютаUSD      - СправочникСсылка.Валюты.
//
// Возвращаемое значение:
//   Булево.
&НаСервере
Функция ТребуетсяПересчетВUSD(ИсходнаяСтрока, ВалютаUSD)

    Если ВалютаUSD = ИсходнаяСтрока.ВалютаДокументаПоставщика Тогда
        Возврат Ложь;
    КонецЕсли;
    Если Не ЗначениеЗаполнено(ИсходнаяСтрока.ВалютаДокументаПоставщика) Тогда
        Возврат Ложь;
    КонецЕсли;
    Если Не ЗначениеЗаполнено(ИсходнаяСтрока.ДатаСписания) Тогда
        Возврат Ложь;
    КонецЕсли;
    Возврат Истина;

КонецФункции

// Загружает курсы валют одним запросом. Курсы группируются по валютам и сортируются
// по периоду ASC — это позволяет искать последний курс на дату проходом с конца массива.
//
// Параметры:
//   МассивВалют - Массив - ссылки на валюты.
//
// Возвращаемое значение:
//   Соответствие - ключ = Валюта, значение = Массив структур {Период, Курс, Кратность}.
&НаСервере
Функция ЗагрузитьКурсыПоВалютам(МассивВалют)

    КурсыПоВалютам = Новый Соответствие;

    ЗапросКурсов = Новый Запрос;
    ЗапросКурсов.Текст =
    "ВЫБРАТЬ
    |   КурсыВалют.Валюта КАК Валюта,
    |   КурсыВалют.Период КАК Период,
    |   КурсыВалют.Курс КАК Курс,
    |   КурсыВалют.Кратность КАК Кратность
    |ИЗ
    |   РегистрСведений.КурсыВалют КАК КурсыВалют
    |ГДЕ
    |   КурсыВалют.Валюта В (&МассивВалют)
    |УПОРЯДОЧИТЬ ПО
    |   КурсыВалют.Валюта,
    |   КурсыВалют.Период";
    ЗапросКурсов.УстановитьПараметр("МассивВалют", МассивВалют);

    ВыборкаКурсов = ЗапросКурсов.Выполнить().Выбрать();
    Пока ВыборкаКурсов.Следующий() Цикл
        МассивКурсов = КурсыПоВалютам.Получить(ВыборкаКурсов.Валюта);
        Если МассивКурсов = Неопределено Тогда
            МассивКурсов = Новый Массив;
            КурсыПоВалютам.Вставить(ВыборкаКурсов.Валюта, МассивКурсов);
        КонецЕсли;
        МассивКурсов.Добавить(Новый Структура("Период, Курс, Кратность",
            ВыборкаКурсов.Период, ВыборкаКурсов.Курс, ВыборкаКурсов.Кратность));
    КонецЦикла;

    Возврат КурсыПоВалютам;

КонецФункции

// Заполняет КэшКурсов для каждой уникальной пары (Валюта, Дата), находя последний курс
// на нужную дату в массиве курсов валюты.
//
// Параметры:
//   КэшКурсов       - Соответствие - заполняемый кэш (ключ = Валюта + "_" + Дата, значение = Структура("Курс, Кратность")).
//   УникальныеПары  - Соответствие - ключ = Валюта, значение = Соответствие дат.
//   КурсыПоВалютам  - Соответствие - ключ = Валюта, значение = Массив структур {Период, Курс, Кратность}.
&НаСервере
Процедура ЗаполнитьКэшИзКурсов(КэшКурсов, УникальныеПары, КурсыПоВалютам)

    Для Каждого КиП Из УникальныеПары Цикл
        Валюта = КиП.Ключ;
        МассивКурсов = КурсыПоВалютам.Получить(Валюта);
        Если МассивКурсов = Неопределено Тогда
            Продолжить;
        КонецЕсли;
        Для Каждого КиДата Из КиП.Значение Цикл
            Дата = КиДата.Ключ;
            КурсИКратность = НайтиПоследнийКурсНаДату(МассивКурсов, Дата);
            Если КурсИКратность <> Неопределено Тогда
                КлючКэша = XMLСтрока(Валюта) + "_" + XMLСтрока(Дата);
                КэшКурсов.Вставить(КлючКэша, КурсИКратность);
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;

КонецПроцедуры

// Ищет последний курс с Период <= Дата в отсортированном по Период ASC массиве.
//
// Параметры:
//   МассивКурсов - Массив - структуры {Период, Курс, Кратность}, отсортированные по Период ASC.
//   Дата         - Дата.
//
// Возвращаемое значение:
//   Неопределено или Структура("Курс, Кратность").
&НаСервере
Функция НайтиПоследнийКурсНаДату(МассивКурсов, Дата)

    Для Индекс = МассивКурсов.ВГраница() По 0 Цикл
        Если МассивКурсов[Индекс].Период <= Дата Тогда
            Возврат Новый Структура("Курс, Кратность",
                МассивКурсов[Индекс].Курс,
                МассивКурсов[Индекс].Кратность);
        КонецЕсли;
    КонецЦикла;

    Возврат Неопределено;

КонецФункции

// Пересчитывает сумму в USD по заранее построенному кэшу курсов.
// Формула соответствует РаботаСКурсамиВалют.ПересчитатьВВалюту:
//   Сумма * Курс / Кратность.
// Если в кэше нет курса для пары (Валюта, ДатаСписания) — возвращает исходную сумму.
//
// Параметры:
//   Сумма         - Число - исходная сумма.
//   Валюта        - СправочникСсылка.Валюты - исходная валюта.
//   ДатаСписания  - Дата - дата курса.
//   КэшКурсов     - Соответствие - кэш, построенный ПолучитьКэшКурсовВалют.
//
// Возвращаемое значение:
//   Число - сумма в USD.
&НаСервере
Функция ПересчитатьСуммуВUSDПоКэшу(Сумма, Валюта, ДатаСписания, КэшКурсов)

    Если Не ЗначениеЗаполнено(Сумма) Тогда
        Возврат 0;
    КонецЕсли;
    Если Не ЗначениеЗаполнено(Валюта) Тогда
        Возврат 0;
    КонецЕсли;
    Если Не ЗначениеЗаполнено(ДатаСписания) Тогда
        Возврат 0;
    КонецЕсли;
    Если КэшКурсов = Неопределено Тогда
        Возврат 0;
    КонецЕсли;

    Дата = НачалоДня(ДатаСписания);
    КлючКэша = XMLСтрока(Валюта) + "_" + XMLСтрока(Дата);
    КурсИКратность = КэшКурсов.Получить(КлючКэша);

    Если КурсИКратность = Неопределено Тогда
        Возврат Сумма;
    КонецЕсли;

    Если КурсИКратность.Кратность = 0 Тогда
        Возврат 0;
    КонецЕсли;

    Возврат Сумма * КурсИКратность.Курс / КурсИКратность.Кратность;

КонецФункции

#КонецОбласти


////////////////////////////////////////////////////////////////////////////////
// Конечная номенклатура: элемент, у которого не заполнен НоменклатураТМЦ.
&НаСервере
Функция ПолучитьКонечнуюНоменклатуру(
    ИсходнаяНоменклатура,
    КэшСвязейТМЦ,
    КэшКонечнойНоменклатуры
)

    Если Не ЗначениеЗаполнено(ИсходнаяНоменклатура) Тогда
        Возврат Неопределено;
    КонецЕсли;

    РезультатИзКэша = КэшКонечнойНоменклатуры.Получить(ИсходнаяНоменклатура);
    Если ЗначениеЗаполнено(РезультатИзКэша) Тогда
        Возврат РезультатИзКэша;
    КонецЕсли;

    ТекущаяНоменклатура = ИсходнаяНоменклатура;
    ПроверенныеНоменклатуры = Новый Соответствие;
    ПройденныеНоменклатуры = Новый Массив;
    КонечнаяНоменклатура = Неопределено;

    Пока ЗначениеЗаполнено(ТекущаяНоменклатура) Цикл

        Если ПроверенныеНоменклатуры.Получить(ТекущаяНоменклатура) = Истина Тогда
            Прервать;
        КонецЕсли;

        ПроверенныеНоменклатуры.Вставить(ТекущаяНоменклатура, Истина);
        ПройденныеНоменклатуры.Добавить(ТекущаяНоменклатура);

        РезультатИзКэша = КэшКонечнойНоменклатуры.Получить(ТекущаяНоменклатура);
        Если ЗначениеЗаполнено(РезультатИзКэша) Тогда
            КонечнаяНоменклатура = РезультатИзКэша;
            Прервать;
        КонецЕсли;

        СледующаяНоменклатура = КэшСвязейТМЦ.Получить(ТекущаяНоменклатура);

        Если Не ЗначениеЗаполнено(СледующаяНоменклатура) Тогда
            КонечнаяНоменклатура = ТекущаяНоменклатура;
            Прервать;
        КонецЕсли;

        ТекущаяНоменклатура = СледующаяНоменклатура;

    КонецЦикла;

    Если ЗначениеЗаполнено(КонечнаяНоменклатура) Тогда
        Для Каждого НоменклатураИзЦепочки Из ПройденныеНоменклатуры Цикл
            КэшКонечнойНоменклатуры.Вставить(
                НоменклатураИзЦепочки,
                КонечнаяНоменклатура
            );
        КонецЦикла;
    КонецЕсли;

    Возврат КонечнаяНоменклатура;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Возвращает верхнюю группу переданного элемента справочника Номенклатура.
&НаСервере
Функция ПолучитьВерхнююГруппуНоменклатуры(
    Номенклатура,
    КэшРодителей,
    КэшПризнаковГруппы,
    КэшВерхнихГрупп
)

    Если Не ЗначениеЗаполнено(Номенклатура) Тогда
        Возврат Неопределено;
    КонецЕсли;

    РезультатИзКэша = КэшВерхнихГрупп.Получить(Номенклатура);
    Если ЗначениеЗаполнено(РезультатИзКэша) Тогда
        Возврат РезультатИзКэша;
    КонецЕсли;

    ТекущаяНоменклатура = Номенклатура;
    ВерхняяГруппа = Неопределено;

    Пока ЗначениеЗаполнено(ТекущаяНоменклатура) Цикл

        Если КэшПризнаковГруппы.Получить(ТекущаяНоменклатура) = Истина Тогда
            ВерхняяГруппа = ТекущаяНоменклатура;
        КонецЕсли;

        Родитель = КэшРодителей.Получить(ТекущаяНоменклатура);
        Если Не ЗначениеЗаполнено(Родитель) Тогда
            Прервать;
        КонецЕсли;

        ТекущаяНоменклатура = Родитель;

    КонецЦикла;

    Если ЗначениеЗаполнено(ВерхняяГруппа) Тогда
        КэшВерхнихГрупп.Вставить(Номенклатура, ВерхняяГруппа);
    КонецЕсли;

    Возврат ВерхняяГруппа;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// DNA / REBILL определяется по иерархии ИСХОДНОЙ номенклатуры.
&НаСервере
Функция ПолучитьПризнакDNARebill(
    Номенклатура,
    КэшРодителей,
    КэшКодовНоменклатуры,
    КэшПризнаковDNARebill
)

    Если Не ЗначениеЗаполнено(Номенклатура) Тогда
        Возврат "";
    КонецЕсли;

    РезультатИзКэша = КэшПризнаковDNARebill.Получить(Номенклатура);
    Если ЗначениеЗаполнено(РезультатИзКэша) Тогда
        Возврат РезультатИзКэша;
    КонецЕсли;

    ТекущаяНоменклатура = Номенклатура;
    Результат = "";

    Пока ЗначениеЗаполнено(ТекущаяНоменклатура) Цикл

        КодНоменклатуры = КэшКодовНоменклатуры.Получить(ТекущаяНоменклатура);

        Если КодНоменклатуры = "00-00004214" Тогда
            Результат = "REBILL";
            Прервать;
        КонецЕсли;

        Если КодНоменклатуры = "00-00004333"
            ИЛИ КодНоменклатуры = "00-00000767" Тогда
            Результат = "DNA";
        КонецЕсли;

        Родитель = КэшРодителей.Получить(ТекущаяНоменклатура);
        Если Не ЗначениеЗаполнено(Родитель) Тогда
            Прервать;
        КонецЕсли;

        ТекущаяНоменклатура = Родитель;

    КонецЦикла;

    Если ЗначениеЗаполнено(Результат) Тогда
        КэшПризнаковDNARebill.Вставить(Номенклатура, Результат);
    КонецЕсли;

    Возврат Результат;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Верхняя группа статьи затрат.

&НаСервере
Функция ПолучитьВерхнююГруппуСтатьиЗатрат(
