////////////////////////////////////////////////////////////////////////////////
// Загружает все кэши номенклатуры.
&НаСервере
Процедура ЗаполнитьКэшиНоменклатуры(
    КэшСвязейТМЦ,
    КэшРодителей,
    КэшПризнаковГруппы,
    КэшКодовНоменклатуры,
    КэшСтатейЗатрат,
    КэшТиповЗатрат,
    ИспользуемаяНоменклатура
)

    Если ИспользуемаяНоменклатура.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    СвойствоНоменклатураТМЦ =
        ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту(
            "Имя",
            "НоменклатураТМЦ_e8449bf22b654e7ebf5061a76088424a"
        );

    ЗапросСвязей = Новый Запрос;
    ЗапросСвязей.Текст =
    "ВЫБРАТЬ
    |   ДопРеквизиты.Ссылка КАК Номенклатура,
    |   ДопРеквизиты.Значение КАК НоменклатураТМЦ
    |ИЗ
    |   Справочник.Номенклатура.ДополнительныеРеквизиты КАК ДопРеквизиты
    |ГДЕ
    |   ДопРеквизиты.Свойство = &Свойство
    |   И ДопРеквизиты.Ссылка В (&ИспользуемаяНоменклатура)";

    ЗапросСвязей.УстановитьПараметр("Свойство", СвойствоНоменклатураТМЦ);
    ЗапросСвязей.УстановитьПараметр("ИспользуемаяНоменклатура", ИспользуемаяНоменклатура);

    ВыборкаСвязей = ЗапросСвязей.Выполнить().Выбрать();
    Пока ВыборкаСвязей.Следующий() Цикл
        Если ЗначениеЗаполнено(ВыборкаСвязей.НоменклатураТМЦ) Тогда
            КэшСвязейТМЦ.Вставить(
                ВыборкаСвязей.Номенклатура,
                ВыборкаСвязей.НоменклатураТМЦ
            );
        КонецЕсли;
    КонецЦикла;

    // 4.b: Загружаем номенклатуру уровнями иерархии вверх.
    // Сначала сами используемые элементы, затем их родители, и т.д.,
    // пока не останется новых родителей.
    УжеВКэше = Новый Соответствие;
    КЗагрузке = ИспользуемаяНоменклатура;
    Пока КЗагрузке.Количество() > 0 Цикл
        КЗагрузке = ЗагрузитьУровеньНоменклатуры(
            КЗагрузке,
            КэшРодителей,
            КэшПризнаковГруппы,
            КэшКодовНоменклатуры,
            КэшСтатейЗатрат,
            КэшТиповЗатрат,
            УжеВКэше
        );
    КонецЦикла;

КонецПроцедуры


// Загружает один уровень номенклатуры в кэши и возвращает массив
// родителей, которых ещё нет в кэше (для следующего уровня).
&НаСервере
Функция ЗагрузитьУровеньНоменклатуры(
    КЗагрузке,
    КэшРодителей,
    КэшПризнаковГруппы,
    КэшКодовНоменклатуры,
    КэшСтатейЗатрат,
    КэшТиповЗатрат,
    УжеВКэше
)

    РодителиКЗагрузке = Новый Массив;
    Если КЗагрузке.Количество() = 0 Тогда
        Возврат РодителиКЗагрузке;
    КонецЕсли;

    ЗапросНоменклатуры = Новый Запрос;
    ЗапросНоменклатуры.Текст =
    "ВЫБРАТЬ
    |   Номенклатура.Ссылка КАК Номенклатура,
    |   Номенклатура.Родитель КАК Родитель,
    |   Номенклатура.ЭтоГруппа КАК ЭтоГруппа,
    |   Номенклатура.Код КАК Код,
    |   Номенклатура.бит_СтатьяЗатрат КАК бит_СтатьяЗатрат,
    |   Номенклатура.dn_CostType КАК dn_CostType
    |ИЗ
    |   Справочник.Номенклатура КАК Номенклатура
    |ГДЕ
    |   Номенклатура.Ссылка В (&ЗагружаемыеСсылки)";

    ЗапросНоменклатуры.УстановитьПараметр("ЗагружаемыеСсылки", КЗагрузке);

    ВыборкаНоменклатуры = ЗапросНоменклатуры.Выполнить().Выбрать();
    Пока ВыборкаНоменклатуры.Следующий() Цикл
        КэшРодителей.Вставить(
            ВыборкаНоменклатуры.Номенклатура,
            ВыборкаНоменклатуры.Родитель
        );
        КэшПризнаковГруппы.Вставить(
            ВыборкаНоменклатуры.Номенклатура,
            ВыборкаНоменклатуры.ЭтоГруппа
        );
        КэшКодовНоменклатуры.Вставить(
            ВыборкаНоменклатуры.Номенклатура,
            ВыборкаНоменклатуры.Код
        );
        КэшСтатейЗатрат.Вставить(
            ВыборкаНоменклатуры.Номенклатура,
            ВыборкаНоменклатуры.бит_СтатьяЗатрат
        );
        КэшТиповЗатрат.Вставить(
            ВыборкаНоменклатуры.Номенклатура,
            ВыборкаНоменклатуры.dn_CostType
        );
        УжеВКэше.Вставить(ВыборкаНоменклатуры.Номенклатура, Истина);

        Родитель = ВыборкаНоменклатуры.Родитель;
        Если ЗначениеЗаполнено(Родитель)
           	И УжеВКэше.Получить(Родитель) = Неопределено Тогда
            УжеВКэше.Вставить(Родитель, Истина);
            РодителиКЗагрузке.Добавить(Родитель);
        КонецЕсли;
    КонецЦикла;

    Возврат РодителиКЗагрузке;

КонецФункции


////////////////////////////////////////////////////////////////////////////////

&НаСервере
Процедура ЗаполнитьКэшиСтатейЗатрат(
    КэшРодителей,
    КэшПризнаковГруппы
)

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   СтатьиЗатрат.Ссылка КАК СтатьяЗатрат,
    |   СтатьиЗатрат.Родитель КАК Родитель,
    |   СтатьиЗатрат.ЭтоГруппа КАК ЭтоГруппа
    |ИЗ
    |   Справочник.СтатьиЗатрат КАК СтатьиЗатрат";

    Для Каждого СтрокаСтатьи Из Запрос.Выполнить().Выгрузить() Цикл
        КэшРодителей.Вставить(СтрокаСтатьи.СтатьяЗатрат, СтрокаСтатьи.Родитель);
        КэшПризнаковГруппы.Вставить(
            СтрокаСтатьи.СтатьяЗатрат,
            СтрокаСтатьи.ЭтоГруппа
        );
    КонецЦикла;

КонецПроцедуры

//
Функция РассчитатьКэшИМОПоДокументам(ИсходныеДанные)

    КэшДокументИМО = Новый Соответствие;

    Если ИсходныеДанные.Количество() = 0 Тогда
        Возврат КэшДокументИМО;
    КонецЕсли;

    // 1. Соберём список уникальных документов и подразделений из исходных данных.
    ДокументыДляОбработки = Новый Соответствие;
    Подразделения = Новый Массив;
    УжеСобраноПодразделений = Новый Соответствие;

    Для Каждого Строка Из ИсходныеДанные Цикл
        Если Не ЗначениеЗаполнено(Строка.ДокументПоставщика) Тогда
            Продолжить;
        КонецЕсли;
        ДокументыДляОбработки.Вставить(Строка.ДокументПоставщика, Истина);

        Если Не ЗначениеЗаполнено(Строка.бит_Деливери) Тогда
            Продолжить;
        КонецЕсли;

        Если УжеСобраноПодразделений.Получить(Строка.бит_Деливери) = Неопределено Тогда
            УжеСобраноПодразделений.Вставить(Строка.бит_Деливери, Истина);
            Подразделения.Добавить(Строка.бит_Деливери);
        КонецЕсли;
    КонецЦикла;

    Если ДокументыДляОбработки.Количество() = 0
        ИЛИ Подразделения.Количество() = 0 Тогда
        Возврат КэшДокументИМО;
    КонецЕсли;

    // 2. Ищем свойство доп. реквизита, через который Деливери связан с Организацией.
    //    В разных базах Имя и Наименование свойства могут различаться, поэтому
    //    пробуем несколько вариантов поиска.
    СвойствоOrganizationRegOwner = Неопределено;

    ВариантыПоиска = Новый Массив;
    ВариантыПоиска.Добавить(Новый Структура("Реквизит, Значение", "Наименование", "OrganizationRegOwner"));
    ВариантыПоиска.Добавить(Новый Структура("Реквизит, Значение", "Наименование", "OrganizationRegOwner_3172803dd2e54c5ba9f79daa2a589eec"));
    ВариантыПоиска.Добавить(Новый Структура("Реквизит, Значение", "Имя", "OrganizationRegOwner_3172803dd2e54c5ba9f79daa2a589eec"));

    Для Каждого Вариант Из ВариантыПоиска Цикл
        Если Вариант.Реквизит = "Наименование" Тогда
            НайденноеСвойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию(
                Вариант.Значение);
        Иначе
            НайденноеСвойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту(
                Вариант.Реквизит,
                Вариант.Значение);
        КонецЕсли;

        Если ЗначениеЗаполнено(НайденноеСвойство) Тогда
            СвойствоOrganizationRegOwner = НайденноеСвойство;
            Прервать;
        КонецЕсли;
    КонецЦикла;

    // Если ни один из известных вариантов не найден — возвращаем пустой кэш.
    // Документы без валидной связи Деливери -> Организация -> IMO останутся с "".
    Если НЕ ЗначениеЗаполнено(СвойствоOrganizationRegOwner) Тогда
        Возврат КэшДокументИМО;
    КонецЕсли;

    // 3. Одним запросом получаем Подразделение -> Организация -> IMO.
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ РАЗЛИЧНЫЕ
    |   ДопРеквизиты.Ссылка КАК Подразделение,
    |   ДопРеквизиты.Значение КАК Организация,
    |   Организации.IMO КАК IMO
    |ИЗ
    |   Справочник.ПодразделенияОрганизаций.ДополнительныеРеквизиты КАК ДопРеквизиты
    |       ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
    |       ПО ДопРеквизиты.Значение = Организации.Ссылка
    |ГДЕ
    |   ДопРеквизиты.Ссылка В (&Подразделения)
    |   И ДопРеквизиты.Свойство = &Свойство";
    Запрос.УстановитьПараметр("Подразделения", Подразделения);
    Запрос.УстановитьПараметр("Свойство", СвойствоOrganizationRegOwner);

    КэшПодразделениеИМО = Новый Соответствие;
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        ЗначениеИМО = "";
        Если Выборка.IMO <> NULL Тогда
            ЗначениеИМО = Строка(Выборка.IMO);
        КонецЕсли;
        КэшПодразделениеИМО.Вставить(
            Выборка.Подразделение,
            Новый Структура("Организация, IMO", Выборка.Организация, ЗначениеИМО));
    КонецЦикла;

    // 3.1. Пост-обработка: если у подразделения не нашлось IMO, но его наименование
    //      (без учёта регистра) равно "TRANSFER" — подставляем "TRANSFER" как IMO.
    //      Приоритет "IMO важнее TRANSFER" соблюдается автоматически: перезапись
    //      выполняется только для записей с пустым IMO.
    //
    //      Обходим именно Подразделения, а не КэшПодразделениеИМО — иначе подразделения
    //      без OrganizationRegOwner (типичный случай для TRANSFER) сюда не попадут.
    Для Каждого Подразделение Из Подразделения Цикл
        ДанныеПодразделения = КэшПодразделениеИМО.Получить(Подразделение);
        Если ДанныеПодразделения = Неопределено Тогда
            ДанныеПодразделения = Новый Структура("Организация, IMO", NULL, "");
            КэшПодразделениеИМО.Вставить(Подразделение, ДанныеПодразделения);
        КонецЕсли;

        Если ЗначениеЗаполнено(ДанныеПодразделения.IMO) Тогда
            Продолжить;
        КонецЕсли;

      НаименованиеВРег = ВРег(Строка(Подразделение.Наименование));

        Если НаименованиеВРег = "TRANSFER" Тогда
            ДанныеПодразделения.IMO = "TRANSFER";
        ИначеЕсли СтрНайти(НаименованиеВРег, "MAIN OFFICE") > 0 Тогда
            ДанныеПодразделения.IMO = "Main Office";
        Иначе
            // Ни одно правило не сработало — оставляем IMO пустым.
		КонецЕсли;
		
    КонецЦикла;

    // 4. По каждой строке исходных данных собираем набор уникальных IMO для документа.
    ПарыДокументИМО = Новый Соответствие;

    Для Каждого Строка Из ИсходныеДанные Цикл
        Если Не ЗначениеЗаполнено(Строка.ДокументПоставщика) Тогда
            Продолжить;
        КонецЕсли;
        Если Не ЗначениеЗаполнено(Строка.бит_Деливери) Тогда
            Продолжить;
        КонецЕсли;

        ДанныеПодразделения = КэшПодразделениеИМО.Получить(Строка.бит_Деливери);
        Если ДанныеПодразделения = Неопределено Тогда
            Продолжить;
        КонецЕсли;

        ЗначениеИМО = ДанныеПодразделения.IMO;
        Если Не ЗначениеЗаполнено(ЗначениеИМО) Тогда
            Продолжить;
        КонецЕсли;

        СохраненныеИМО = ПарыДокументИМО.Получить(Строка.ДокументПоставщика);
        Если СохраненныеИМО = Неопределено Тогда
            СохраненныеИМО = Новый Соответствие;
            ПарыДокументИМО.Вставить(Строка.ДокументПоставщика, СохраненныеИМО);
        КонецЕсли;
        СохраненныеИМО.Вставить(ЗначениеИМО, Истина);
    КонецЦикла;

    // 5. По каждому документу формируем итоговое значение.
    Для Каждого Документ Из ДокументыДляОбработки Цикл
        СохраненныеИМО = ПарыДокументИМО.Получить(Документ.Ключ);
        Если СохраненныеИМО = Неопределено
            ИЛИ СохраненныеИМО.Количество() = 0 Тогда
            КэшДокументИМО.Вставить(Документ.Ключ, "");
            Продолжить;
        КонецЕсли;

        Если СохраненныеИМО.Количество() = 1 Тогда
            Для Каждого ИМОИзСписка Из СохраненныеИМО Цикл
                КэшДокументИМО.Вставить(Документ.Ключ, ИМОИзСписка.Ключ);
                Прервать;
            КонецЦикла;
        Иначе
            КэшДокументИМО.Вставить(Документ.Ключ, "MULTI");
        КонецЕсли;
    КонецЦикла;

    Возврат КэшДокументИМО;

КонецФункции

