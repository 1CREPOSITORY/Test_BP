
Функция СведенияОВнешнейОбработке() Экспорт
    
    ИмяОтчета = ЭтотОбъект.Метаданные().Имя; 
    Синоним = ЭтотОбъект.Метаданные().Синоним; 
    Синоним = ?(ЗначениеЗаполнено(Синоним),Синоним, ИмяОтчета);         
    РегистрационныеДанные = Новый Структура;
    РегистрационныеДанные.Вставить("Вид","ДополнительныйОтчет"); //может быть – ПечатнаяФорма, ЗаполнениеОбъекта (для вн.обработки), ДополнительныйОтчет, СозданиеСвязанныхОбъектов… 
    РегистрационныеДанные.Вставить("Наименование", Синоним); //имя под которым обработка будет зарегестрирована в справочнике внешних обработок
    РегистрационныеДанные.Вставить("Версия", "1.0");
    РегистрационныеДанные.Вставить("БезопасныйРежим", Ложь);
    РегистрационныеДанные.Вставить("Информация", "Отчет "+Синоним); //так будет выглядеть описание вн.отчета для пользователя
    
    ТаблицаКоманд = ПолучитьТаблицуКоманд();
    
    // Добавим команду в таблицу
    ДобавитьКоманду(ТаблицаКоманд, Синоним, "СформироватьОтчет" , "ОткрытиеФормы", Истина, );
        
    // Сохраним таблицу команд в параметры регистрации обработки
    РегистрационныеДанные.Вставить("Команды", ТаблицаКоманд);
    
    Возврат РегистрационныеДанные;
                                       
КонецФункции

Функция ПолучитьТаблицуКоманд()
    
    // Создадим пустую таблицу команд и колонки в ней
    Команды = Новый ТаблицаЗначений;

    // Как будет выглядеть описание печатной формы для пользователя
    Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка")); 

    // Имя нашего макета, что бы могли отличить вызванную команду в обработке печати
    Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));

    // Тут задается, как должна вызваться команда обработки
    // Возможные варианты:
    // - ОткрытиеФормы - в этом случае в колонке идентификатор должно быть указано имя формы, которое должна будет открыть система
    // - ВызовКлиентскогоМетода - вызвать клиентскую экспортную процедуру из модуля формы обработки
    // - ВызовСерверногоМетода - вызвать серверную экспортную процедуру из модуля объекта обработки
    Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));

    // Следующий параметр указывает, необходимо ли показывать оповещение при начале и завершению работы обработки. Не имеет смысла при открытии формы
    Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));

    // Для печатной формы должен содержать строку ПечатьMXL 
    Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
    Возврат Команды;
   
КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование = "ОткрытиеФормы", ПоказыватьОповещение = Ложь, Модификатор = "ПечатьMXL")
    
    // Добавляем команду в таблицу команд по переданному описанию.
    // Параметры и их значения можно посмотреть в функции ПолучитьТаблицуКоманд
    НоваяКоманда = ТаблицаКоманд.Добавить();
    НоваяКоманда.Представление = Представление;
    НоваяКоманда.Идентификатор = Идентификатор;
    НоваяКоманда.Использование = Использование;
    НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
    НоваяКоманда.Модификатор = Модификатор;

КонецПроцедуры    

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	УстановитьПривилегированныйРежим(Истина);
	
	СтандартнаяОбработка = Ложь;
	НастройкиМодифицированы = Ложь;
	
	НастройкиОтчета = КомпоновщикНастроек.ПолучитьНастройки();
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиОтчета, ДанныеРасшифровки);
	
	ВнешниеНаборыДанных = Новый Структура;
	
	#Область Период
	
	Период = КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[0].Значение;

    Если Период = Неопределено Тогда
        ВызватьИсключение
            "Не заполнен пользовательский параметр Период.";
    КонецЕсли;

    Если Не ЗначениеЗаполнено(Период.ДатаНачала) Тогда
        ВызватьИсключение
            "Не заполнена дата начала периода.";
    КонецЕсли;

    Если Не ЗначениеЗаполнено(Период.ДатаОкончания) Тогда
        ВызватьИсключение
            "Не заполнена дата окончания периода.";
    КонецЕсли;

    ДатаНачала = НачалоДня(Период.ДатаНачала);

    ДатаОкончания = КонецДня(Период.ДатаОкончания);
		
	ГраницаНачала =   Новый Граница(НачалоДня(ДатаНачала),ВидГраницы.Включая);
	ГраницаДатаНачала = ГраницаНачала.Значение;
	ГраницаОкончания = Новый Граница(КонецДня(ДатаОкончания), ВидГраницы.Включая);
	ГраницаДатаОкончания = ГраницаОкончания.Значение;
    #КонецОбласти
	
	
	ДанныеОтчета = СформироватьДанныеОтчета(ГраницаДатаНачала, ГраницаДатаОкончания);
	ВнешниеНаборыДанных.Вставить("ДанныеОтчета", ДанныеОтчета);
	

	КэшСуммаUSDПоВидамОпераций = Новый ТаблицаЗначений;
	КэшСуммаUSDПоВидамОпераций.Колонки.Добавить(
		"ВидОперации3",
		Новый ОписаниеТипов("Строка")
	);
	КэшСуммаUSDПоВидамОпераций.Колонки.Добавить(
		"ВидОперации3Ссылка",
		Новый ОписаниеТипов("ПеречислениеСсылка.ВидыОперацийСписаниеДенежныхСредств")
	);
	КэшСуммаUSDПоВидамОпераций.Колонки.Добавить("СуммаUSD", Новый ОписаниеТипов("Число"));
	КэшСуммаUSDПоВидамОпераций.Колонки.Добавить(
		"ВходитВГруппу",
		Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(1, 0))
	);

	// Один проход по ДанныеОтчета: собираем уникальные виды операций
	// и сразу накапливаем сумму СуммаОплатыРаспределеннаяUSD.
	ПоискСтрокиКэша = Новый Соответствие;
	Для Каждого Строка Из ДанныеОтчета Цикл
		КлючВидаОперации = Строка(Строка.ВидОперации);
		НайденнаяСтрока = ПоискСтрокиКэша.Получить(КлючВидаОперации);
		Если НайденнаяСтрока = Неопределено Тогда
			НайденнаяСтрока = КэшСуммаUSDПоВидамОпераций.Добавить();
			НайденнаяСтрока.ВидОперации3       = КлючВидаОперации;
			НайденнаяСтрока.ВидОперации3Ссылка = Строка.ВидОперации;
			НайденнаяСтрока.СуммаUSD          = 0;
			НайденнаяСтрока.ВходитВГруппу     = 1;
			ПоискСтрокиКэша.Вставить(КлючВидаОперации, НайденнаяСтрока);
		КонецЕсли;
		НайденнаяСтрока.СуммаUSD = НайденнаяСтрока.СуммаUSD + Строка.СуммаОплатыРаспределеннаяUSD;
	КонецЦикла;

		//КэшСуммаUSDПоВидамОпераций.Свернуть("ВидОперации,ВидОперацииСсылка,ВходитВГруппу","СуммаUSD");
		
		ДанныеОтчета2 = СформироватьДанныеОтчета2(
		ДатаНачала,
		ДатаОкончания,
		КэшСуммаUSDПоВидамОпераций);
		
		ВнешниеНаборыДанных.Вставить("ДанныеОтчета2", ДанныеОтчета2);

	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;

	ПроцессорКомпоновки.Инициализировать(
	    МакетКомпоновки,
	    ВнешниеНаборыДанных,
	    ДанныеРасшифровки,
	    Истина
	);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	
	
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	ДокументРезультат.ПоказатьУровеньГруппировокСтрок(0);

КонецПроцедуры

&НаСервере
Функция СформироватьДанныеОтчета(ДатаНачала, ДатаОкончания) Экспорт
	
    ЗапросДанных = Новый Запрос;
    ЗапросДанных.Текст = ПолучитьТекстЗапросаДанныхОтчета();
	
	ЗапросДанных.УстановитьПараметр("ДатаНачала",    ДатаНачала);
    ЗапросДанных.УстановитьПараметр("ДатаОкончания", ДатаОкончания);

		
    ИсходныеДанные = ЗапросДанных.Выполнить().Выгрузить();
	
	// 4.a: Собираем уникальные ссылки на номенклатуру из исходных данных,
	// чтобы в кэши грузить только нужные элементы (а не весь справочник).
	ИспользуемаяНоменклатура = Новый Массив;
	УжеСобраноНоменклатуры = Новый Соответствие;
	Для Каждого ИсходнаяСтрока Из ИсходныеДанные Цикл
		Если Не ЗначениеЗаполнено(ИсходнаяСтрока.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		КлючНоменклатуры = ИсходнаяСтрока.Номенклатура;
		Если УжеСобраноНоменклатуры.Получить(КлючНоменклатуры) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		УжеСобраноНоменклатуры.Вставить(КлючНоменклатуры, Истина);
		ИспользуемаяНоменклатура.Добавить(КлючНоменклатуры);
	КонецЦикла;

	
	КэшДокументИМО = РассчитатьКэшИМОПоДокументам(ИсходныеДанные);
	
    РабочиеДанные = СоздатьРабочуюТаблицуПоСтатьямЗатрат();
    ДанныеОтчета = СоздатьИтоговуюТаблицуДанныхОтчета();

    КэшСвязейТМЦ = Новый Соответствие;
    КэшРодителейНоменклатуры = Новый Соответствие;
    КэшПризнаковГруппыНоменклатуры = Новый Соответствие;
    КэшКодовНоменклатуры = Новый Соответствие;
    КэшСтатейЗатрат = Новый Соответствие;
    КэшТиповЗатрат = Новый Соответствие; 
	
    ЗаполнитьКэшиНоменклатуры(
        КэшСвязейТМЦ,
        КэшРодителейНоменклатуры,
        КэшПризнаковГруппыНоменклатуры,
        КэшКодовНоменклатуры,
        КэшСтатейЗатрат,
        КэшТиповЗатрат,
        ИспользуемаяНоменклатура
    );

    КэшРодителейСтатейЗатрат = Новый Соответствие;
    КэшПризнаковГруппыСтатейЗатрат = Новый Соответствие;
    ЗаполнитьКэшиСтатейЗатрат(
        КэшРодителейСтатейЗатрат,
        КэшПризнаковГруппыСтатейЗатрат
    );

    КэшКонечнойНоменклатуры = Новый Соответствие;
    КэшВерхнихГруппНоменклатуры = Новый Соответствие;
    КэшПризнаковDNARebill = Новый Соответствие;
    КэшВерхнихГруппСтатейЗатрат = Новый Соответствие;

    ВалютаUSD = Справочники.Валюты.НайтиПоКоду("840");
    КэшКурсов = ПолучитьКэшКурсовВалют(ИсходныеДанные, ВалютаUSD);

    Для Каждого ИсходнаяСтрока Из ИсходныеДанные Цикл

			
		Если ИсходнаяСтрока.ВидОплаты = "Other"
			ИЛИ ИсходнаяСтрока.ВидОплаты = "WithoutDoc" Тогда
			
			НоваяРабочаяСтрока =
			РабочиеДанные.Добавить();
			
			ЗаполнитьЗначенияСвойств(
			НоваяРабочаяСтрока,
			ИсходнаяСтрока);
			
			НоваяРабочаяСтрока.ВерхняяГруппаНоменклатуры =	Неопределено;
			
			НоваяРабочаяСтрока.бит_СтатьяЗатрат = 	Неопределено;
			
			НоваяРабочаяСтрока.ВерхняяГруппаСтатьиЗатрат = 	Неопределено;
			
			НоваяРабочаяСтрока.dn_CostType = "";
			
			НоваяРабочаяСтрока.ПризнакDNARebill ="";
			
			НоваяРабочаяСтрока.ОплатаЗа ="";
			
			////////////////////////////////////////////////////////////////////////////
			// Для Other и WithoutDoc нет строк товаров / услуг.
			// Поэтому распределение не выполняем:
			// вся сумма остаётся одной строкой.
			
			НоваяРабочаяСтрока.СуммаСтрокиПоСтатье = ИсходнаяСтрока.СуммаОплаты;
			
			НоваяРабочаяСтрока.СуммаДокументаПоставщика =  	ИсходнаяСтрока.СуммаОплаты;
			
			НоваяРабочаяСтрока.СуммаДокументаПоставщикаUSD = ИсходнаяСтрока.СуммаСписанияUSD;
			
			НоваяРабочаяСтрока.СуммаСтрокиПоСтатьеUSD =  ИсходнаяСтрока.СуммаСписанияUSD;
			
			НоваяРабочаяСтрока.IMO = "";
			
			Продолжить;
			
		КонецЕсли;     


        Если Не ЗначениеЗаполнено(ИсходнаяСтрока.Номенклатура) Тогда
            Продолжить;
        КонецЕсли;

        КонечнаяНоменклатура = ПолучитьКонечнуюНоменклатуру(
            ИсходнаяСтрока.Номенклатура,
            КэшСвязейТМЦ,
            КэшКонечнойНоменклатуры
        );

        ВерхняяГруппаНоменклатуры = ПолучитьВерхнююГруппуНоменклатуры(
            ИсходнаяСтрока.Номенклатура,
            КэшРодителейНоменклатуры,
            КэшПризнаковГруппыНоменклатуры,
            КэшВерхнихГруппНоменклатуры
        );

        СтатьяЗатрат = КэшСтатейЗатрат.Получить(КонечнаяНоменклатура);
        ТипЗатрат = КэшТиповЗатрат.Получить(КонечнаяНоменклатура);

        ВерхняяГруппаСтатьиЗатрат = ПолучитьВерхнююГруппуСтатьиЗатрат(
            СтатьяЗатрат,
            КэшРодителейСтатейЗатрат,
            КэшПризнаковГруппыСтатейЗатрат,
            КэшВерхнихГруппСтатейЗатрат
        );

        ПризнакDNARebill = ПолучитьПризнакDNARebill(
            ИсходнаяСтрока.Номенклатура,
            КэшРодителейНоменклатуры,
            КэшКодовНоменклатуры,
            КэшПризнаковDNARebill
        );

        Если КэшКодовНоменклатуры.Получить(ИсходнаяСтрока.Номенклатура) = "BP-00012208" Тогда
            ОплатаЗа = "Yes";
        Иначе
            ОплатаЗа = "";
        КонецЕсли;
		
		Если ВалютаUSD = ИсходнаяСтрока.ВалютаДокументаПоставщика Тогда
			СуммаДокументаПоставщикаUSD = ИсходнаяСтрока.СуммаДокументаПоставщика;	
			СуммаСтрокиUSD = ИсходнаяСтрока.СуммаСтроки;	
		Иначе
	        СуммаДокументаПоставщикаUSD = ПересчитатьСуммуВUSDПоКэшу(
	            ИсходнаяСтрока.СуммаДокументаПоставщика,
	            ИсходнаяСтрока.ВалютаДокументаПоставщика,
	            ИсходнаяСтрока.ДатаСписания,
	            КэшКурсов
	        );

	        СуммаСтрокиUSD = ПересчитатьСуммуВUSDПоКэшу(
	            ИсходнаяСтрока.СуммаСтроки,
	            ИсходнаяСтрока.ВалютаДокументаПоставщика,
	            ИсходнаяСтрока.ДатаСписания,
	            КэшКурсов
	        );
		КонецЕсли;

        НоваяРабочаяСтрока = РабочиеДанные.Добавить();
        ЗаполнитьЗначенияСвойств(НоваяРабочаяСтрока, ИсходнаяСтрока);

        НоваяРабочаяСтрока.ВерхняяГруппаНоменклатуры = ВерхняяГруппаНоменклатуры;
        НоваяРабочаяСтрока.бит_СтатьяЗатрат = СтатьяЗатрат;
        НоваяРабочаяСтрока.ВерхняяГруппаСтатьиЗатрат = ВерхняяГруппаСтатьиЗатрат;
        НоваяРабочаяСтрока.dn_CostType = ТипЗатрат;
        НоваяРабочаяСтрока.ПризнакDNARebill = ПризнакDNARebill;
        НоваяРабочаяСтрока.ОплатаЗа = ОплатаЗа;
        НоваяРабочаяСтрока.СуммаДокументаПоставщикаUSD = СуммаДокументаПоставщикаUSD;
        НоваяРабочаяСтрока.СуммаСтрокиПоСтатье = ИсходнаяСтрока.СуммаСтроки;
        НоваяРабочаяСтрока.СуммаСтрокиПоСтатьеUSD = СуммаСтрокиUSD;
        НоваяРабочаяСтрока.IMO = ?(ЗначениеЗаполнено(ИсходнаяСтрока.ДокументПоставщика),КэшДокументИМО.Получить(ИсходнаяСтрока.ДокументПоставщика),"");
    КонецЦикла;

    // Суммируются только базы распределения по строкам номенклатуры.
    // Суммы оплаты и документа поставщика включены в ключ, чтобы не задваиваться.
	РабочиеДанные.Свернуть(
	    "СсылкаСписания,НомерСписания,ДатаСписания,Организация,Контрагент,КонтрагентКод,ВалютаДокумента,ВидОперации,НомерВходящегоДокумента,ДатаВходящегоДокумента,НомерДокумента,ДатаДокумента,ВидОплаты,ДокументПоставщика,ВалютаДокументаПоставщика,OPS,бит_Деливери,ВерхняяГруппаНоменклатуры,бит_СтатьяЗатрат,ВерхняяГруппаСтатьиЗатрат,dn_CostType,ПризнакDNARebill,IMO,ОплатаЗа,СуммаОплаты,СуммаДокументаПоставщика,СуммаСписанияUSD,СуммаДокументаПоставщикаUSD",
	    "СуммаСтрокиПоСтатье,СуммаСтрокиПоСтатьеUSD"
	);  

	
	 Для Каждого РабочаяСтрока Из РабочиеДанные Цикл

        Если РабочаяСтрока.СуммаДокументаПоставщика = 0 Тогда
            СуммаОплатыРаспределенная = 0;
        Иначе
            // Округляем до 2 знаков (копеек) сразу при распределении.
            // Без этого при делении накапливаются дроби вида 0.0000123,
            // которые при сложении по виду операции превращаются в "шумовые копейки".
            // Корректировку до исходной суммы документа делаем ниже отдельным проходом.
            СуммаОплатыРаспределенная =
                Цел(
                    РабочаяСтрока.СуммаОплаты
                    * РабочаяСтрока.СуммаСтрокиПоСтатье
                    / РабочаяСтрока.СуммаДокументаПоставщика
                    * 100
                ) / 100;
        КонецЕсли;

        Если РабочаяСтрока.СуммаДокументаПоставщикаUSD = 0 Тогда
            СуммаОплатыРаспределеннаяUSD = 0;
        Иначе
            СуммаОплатыРаспределеннаяUSD =
                Цел(
                    РабочаяСтрока.СуммаСписанияUSD
                    * РабочаяСтрока.СуммаСтрокиПоСтатьеUSD
                    / РабочаяСтрока.СуммаДокументаПоставщикаUSD
                    * 100
                ) / 100;
        КонецЕсли;

        НоваяСтрокаОтчета = ДанныеОтчета.Добавить();
        ЗаполнитьЗначенияСвойств(НоваяСтрокаОтчета, РабочаяСтрока);
		НоваяСтрокаОтчета.СуммаОплатыРаспределенная = СуммаОплатыРаспределенная;
		НоваяСтрокаОтчета.СуммаОплатыРаспределеннаяUSD = СуммаОплатыРаспределеннаяUSD; 
	
    КонецЦикла;

    // Корректировка копеечной погрешности по каждому документу:
    // сумма распределённых по строкам может отличаться от исходной СуммаОплаты / СуммаСписанияUSD
    // на доли копейки из-за округления. Разницу добавляем к ПОСЛЕДНЕЙ строке группы,
    // чтобы итог по документу совпадал с исходной суммой (аналог НДС-распределений в 1С:ERP/БП).
    КорректировкаОкругленияПоДокументам(ДанныеОтчета);


    Возврат ДанныеОтчета;

КонецФункции

&НаСервере
Процедура КорректировкаОкругленияПоДокументам(ДанныеОтчета)

    Если ДанныеОтчета.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    // Для каждого документа храним:
    //   Ключ       = СсылкаСписания
    //   Значение   = Структура с накопленными суммами и индексом последней строки.
    //   СуммаОплаты и СуммаСписанияUSD — исходные суммы документа (одинаковы
    //   во всех строках одного документа, они в измерениях Свернуть).
    //   Эти значения храним в самой структуре, т.к. в ДанныеОтчета они
    //   теперь есть (добавлены в СоздатьИтоговуюТаблицуДанныхОтчета), но
    //   читать удобнее отсюда — без обхода строк во втором проходе.
    ПоследняяСтрокаПоДокументу = Новый Соответствие;

    // Первый проход: для каждой строки запоминаем индекс последней строки её документа
    // и накапливаем фактические суммы распределения.
    Для Индекс = 0 По ДанныеОтчета.Количество() - 1 Цикл
        Строка = ДанныеОтчета[Индекс];
        КлючДокумента = Строка.СсылкаСписания;

        ДанныеДокумента = ПоследняяСтрокаПоДокументу.Получить(КлючДокумента);
        Если ДанныеДокумента = Неопределено Тогда
            ДанныеДокумента = Новый Структура;
            ДанныеДокумента.Вставить("ИндексПоследнейСтроки", Индекс);
            ДанныеДокумента.Вставить("СуммаРаспределено", 0);
            ДанныеДокумента.Вставить("СуммаРаспределеноUSD", 0);
            ДанныеДокумента.Вставить("СуммаОплаты", Строка.СуммаОплаты);
            ДанныеДокумента.Вставить("СуммаСписанияUSD", Строка.СуммаСписанияUSD);
            ПоследняяСтрокаПоДокументу.Вставить(КлючДокумента, ДанныеДокумента);
        Иначе
            ДанныеДокумента.ИндексПоследнейСтроки = Индекс;
        КонецЕсли;

        ДанныеДокумента.СуммаРаспределено    = ДанныеДокумента.СуммаРаспределено
                                              + Строка.СуммаОплатыРаспределенная;
        ДанныеДокумента.СуммаРаспределеноUSD = ДанныеДокумента.СуммаРаспределеноUSD
                                              + Строка.СуммаОплатыРаспределеннаяUSD;
    КонецЦикла;

    // Второй проход: для каждого документа считаем разницу и добавляем её
    // к последней строке группы. Исходные суммы читаем из ДанныеДокумента.
    Для Каждого КлючИЗначение Из ПоследняяСтрокаПоДокументу Цикл
        ДанныеДокумента = КлючИЗначение.Значение;
        ПоследняяСтрока = ДанныеОтчета[ДанныеДокумента.ИндексПоследнейСтроки];

        // По рублёвой сумме (если в строках есть СуммаОплаты)
        Если ДанныеДокумента.СуммаОплаты <> 0 Тогда
            Разница = ДанныеДокумента.СуммаОплаты - ДанныеДокумента.СуммаРаспределено;
            ПоследняяСтрока.СуммаОплатыРаспределенная =
                ПоследняяСтрока.СуммаОплатыРаспределенная + Разница;
        КонецЕсли;

        // По сумме в USD (если в строках есть СуммаСписанияUSD)
        Если ДанныеДокумента.СуммаСписанияUSD <> 0 Тогда
            РазницаUSD = ДанныеДокумента.СуммаСписанияUSD - ДанныеДокумента.СуммаРаспределеноUSD;
            ПоследняяСтрока.СуммаОплатыРаспределеннаяUSD =
                ПоследняяСтрока.СуммаОплатыРаспределеннаяUSD + РазницаUSD;
        КонецЕсли;
    КонецЦикла;

КонецПроцедуры

// Формирует второй набор данных отчета:
// обороты по счетам 51/52 за период и накопленные СуммаОплатыРаспределеннаяUSD
// по видам операций из первого набора.
//
// Запрос возвращает только строки оборотов. Строки из кэша
// (ВидыОперацийUSD) добавляются в результат программно, чтобы избежать
// проблем с несовместимостью типов при ОБЪЕДИНИТЬ и неявной ПОДСТРОКА/SUBSTRING
// при соединении по строковому ключу.
//
// Сопоставление результата с кэшем по строковому ВидОперации3 и заполнение
// ссылочной колонки ВидОперации3Ссылка выполняется программно.
//
// Параметр КэшСуммаUSDПоВидамОпераций: ТаблицаЗначений с колонками:
//   ВидОперации3       - строка (результат Строка(ВидОперации) для BSL-ключа);
//   ВидОперации3Ссылка - ПеречислениеСсылка.ВидыОперацийСписаниеДенежныхСредств;
//   СуммаUSD           - число (СуммаОплатыРаспределеннаяUSD из первого набора);
//   ВходитВГруппу      - число (0/1).
&НаСервере
Функция СформироватьДанныеОтчета2(ДатаНачала, ДатаОкончания, КэшСуммаUSDПоВидамОпераций)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА СписаниеСРасчетногоСчета.Ссылка ЕСТЬ НЕ NULL 
	|			ТОГДА СписаниеСРасчетногоСчета.ВидОперации
	|		КОГДА ПоступлениеНаРасчетныйСчет.Ссылка ЕСТЬ НЕ NULL 
	|			ТОГДА ПоступлениеНаРасчетныйСчет.ВидОперации
	|		КОГДА РегламентнаяОперация.Ссылка ЕСТЬ НЕ NULL 
	|			ТОГДА РегламентнаяОперация.ВидОперации
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСписаниеДенежныхСредств.ПустаяСсылка)
	|	КОНЕЦ КАК ВидОперации3Ссылка,
	|	СУММА(Обороты.СуммаОборотКт) КАК СуммаКт5152,
	|	СУММА(ВЫБОР
	|			КОГДА Обороты.Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетныеСчета)
	|				ТОГДА Обороты.СуммаОборотКт
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СуммаКт51,
	|	СУММА(ВЫБОР
	|			КОГДА Обороты.Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ВалютныеСчета)
	|				ТОГДА Обороты.СуммаОборотКт
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СуммаКт52
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(&ДатаНачала, &ДатаОкончания, Регистратор, Счет В (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетныеСчета), ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ВалютныеСчета)), , , , ) КАК Обороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СписаниеСРасчетногоСчета КАК СписаниеСРасчетногоСчета
	|		ПО Обороты.Регистратор = СписаниеСРасчетногоСчета.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеНаРасчетныйСчет КАК ПоступлениеНаРасчетныйСчет
	|		ПО Обороты.Регистратор = ПоступлениеНаРасчетныйСчет.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РегламентнаяОперация КАК РегламентнаяОперация
	|		ПО Обороты.Регистратор = РегламентнаяОперация.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР
	|		КОГДА СписаниеСРасчетногоСчета.Ссылка ЕСТЬ НЕ NULL 
	|			ТОГДА СписаниеСРасчетногоСчета.ВидОперации
	|		КОГДА ПоступлениеНаРасчетныйСчет.Ссылка ЕСТЬ НЕ NULL 
	|			ТОГДА ПоступлениеНаРасчетныйСчет.ВидОперации
	|		КОГДА РегламентнаяОперация.Ссылка ЕСТЬ НЕ NULL 
	|			ТОГДА РегламентнаяОперация.ВидОперации
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСписаниеДенежныхСредств.ПустаяСсылка)
	|	КОНЕЦ";

	Запрос.УстановитьПараметр("ДатаНачала",    ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);

	Результат = Запрос.Выполнить().Выгрузить();

	// Колонки ВидОперации3Ссылка, СуммаКт5152, СуммаКт51, СуммаКт52 уже пришли из SQL
	// и сразу агрегированы по виду операции (СГРУППИРОВАТЬ ПО в запросе).
	// Добавляем программно только те, что нужны для последующей обработки и вывода.
	Результат.Колонки.Добавить("ВидОперации3",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100, ДопустимаяДлина.Фиксированная)));
	Результат.Колонки.Добавить("ВходитВГруппу",
		Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(1, 0)));
	Результат.Колонки.Добавить("СуммаUSD", Новый ОписаниеТипов("Число"));
    Результат.Колонки.Добавить("Расхождение",
		Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 2)));
		
		// Гарантируем, что у всех строк нет Неопределено в добавленных колонках.
	// Сразу заполняем дефолты — иначе в дальнейших циклах и арифметике возникнут проблемы.
	Для Каждого Строка Из Результат Цикл
		Строка.ВидОперации3       = "";
		Строка.ВходитВГруппу      = 0;
		Строка.СуммаUSD           = 0;
		Строка.Расхождение        = 0;
	КонецЦикла;   
	
	// Соответствие "строковый ВидОперации3" -> строка кэша.
	ПоискПоСтроке = Новый Соответствие;
	Для Каждого СтрокаКэша Из КэшСуммаUSDПоВидамОпераций Цикл
		ПоискПоСтроке.Вставить(СтрокаКэша.ВидОперации3, СтрокаКэша);
	КонецЦикла;

	// Оборотные строки: получаем строковое представление ссылки и ищем в кэше.
	// Пустые ссылки (ИНАЧЕ в запросе) пропускаем — в кэше их нет.
	ВидыОперацийВОборах = Новый Соответствие;
	Для Каждого Строка Из Результат Цикл
		Если Строка.ВидОперации3Ссылка.Пустая() Тогда
			Продолжить;
		КонецЕсли;
		ВидыОперацийВОборах.Вставить(Строка.ВидОперации3Ссылка, Истина);
		КлючВидаОперации = Строка(Строка.ВидОперации3Ссылка);
		Строка.ВидОперации3 = КлючВидаОперации;
		СтрокаКэша = ПоискПоСтроке.Получить(КлючВидаОперации);
		Если СтрокаКэша <> Неопределено Тогда
			Строка.СуммаUSD      = СтрокаКэша.СуммаUSD;
			Строка.ВходитВГруппу = СтрокаКэша.ВходитВГруппу;
		КонецЕсли;
	КонецЦикла;

	// Из кэша добавляем только те виды операций, по которым нет оборотов
	// (если оборот есть — строка уже сформирована запросом и дополнена данными кэша).
	Для Каждого СтрокаКэша Из КэшСуммаUSDПоВидамОпераций Цикл
		Если ВидыОперацийВОборах.Получить(СтрокаКэша.ВидОперации3Ссылка) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.ВидОперации3       = СтрокаКэша.ВидОперации3;
		НоваяСтрока.ВидОперации3Ссылка = СтрокаКэша.ВидОперации3Ссылка;
		НоваяСтрока.ВходитВГруппу      = СтрокаКэша.ВходитВГруппу;
		НоваяСтрока.СуммаUSD           = СтрокаКэша.СуммаUSD;
	КонецЦикла;
   	// Расхождение = СуммаUSD - СуммаКт5152 для каждой строки результата.
	// Для строк без оборотов СуммаКт5152 = 0 — расхождение равно СуммаUSD.
	Для Каждого Строка Из Результат Цикл
		Строка.Расхождение = Строка.СуммаUSD - Строка.СуммаКт5152;
	КонецЦикла;

	Возврат Результат;  
	
КонецФункции

&НаСервере
Функция ПолучитьТекстЗапросаДанныхОтчета() Экспорт


ТекстЗапроса = "ВЫБРАТЬ
               |	СписаниеСРасчетногоСчета.Ссылка КАК Ссылка,
               |	СписаниеСРасчетногоСчета.Номер КАК Номер,
               |	СписаниеСРасчетногоСчета.Дата КАК Дата,
               |	СписаниеСРасчетногоСчета.Организация КАК Организация,
               |	СписаниеСРасчетногоСчета.Контрагент КАК Контрагент,
               |	СписаниеСРасчетногоСчета.Контрагент.Код КАК КонтрагентКод,
               |	СписаниеСРасчетногоСчета.ВалютаДокумента КАК ВалютаДокумента,
               |	СписаниеСРасчетногоСчета.ВидОперации КАК ВидОперации,
               |	СписаниеСРасчетногоСчета.СуммаДокумента КАК СуммаДокумента,
               |	ХозрасчетныйОборотыДтКт.СуммаОборот КАК СуммаСписанияUSD
               |ПОМЕСТИТЬ СписокСписанийСРС
               |ИЗ
               |	РегистрБухгалтерии.Хозрасчетный.ОборотыДтКт(
               |			&ДатаНачала,
               |			&ДатаОкончания,
               |			Регистратор,
               |			,
               |			,
               |			СчетКт = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетныеСчета)
               |				ИЛИ СчетКт = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ВалютныеСчета),
               |			,
               |			) КАК ХозрасчетныйОборотыДтКт
               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СписаниеСРасчетногоСчета КАК СписаниеСРасчетногоСчета
               |		ПО ХозрасчетныйОборотыДтКт.Регистратор = СписаниеСРасчетногоСчета.Ссылка
               |ГДЕ
               |	СписаниеСРасчетногоСчета.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
               |;
               |
               |////////////////////////////////////////////////////////////////////////////////
