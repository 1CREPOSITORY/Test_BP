    РезультатИзКэша = КэшВерхнихГрупп.Получить(СтатьяЗатрат);
    Если ЗначениеЗаполнено(РезультатИзКэша) Тогда
        Возврат РезультатИзКэша;
    КонецЕсли;

    ТекущаяСтатья = СтатьяЗатрат;
    ВерхняяГруппа = Неопределено;

    Пока ЗначениеЗаполнено(ТекущаяСтатья) Цикл

        Если КэшПризнаковГруппы.Получить(ТекущаяСтатья) = Истина Тогда
            ВерхняяГруппа = ТекущаяСтатья;
        КонецЕсли;

        Родитель = КэшРодителей.Получить(ТекущаяСтатья);
        Если Не ЗначениеЗаполнено(Родитель) Тогда
            Прервать;
        КонецЕсли;

        ТекущаяСтатья = Родитель;

